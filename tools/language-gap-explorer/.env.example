# Deployment configuration only. Copy OUTSIDE the repository, e.g. /etc/neowiki/runtime.env.
# Actual secret values belong in files in NEOWIKI_SECRETS_DIR, never in this file/image.
NEOWIKI_SECRETS_DIR=/etc/neowiki/secrets
NEOWIKI_DATA_DIR=/srv/neowiki/data
NEOWIKI_MODEL_DIR=/srv/neowiki/model-cache
NEOWIKI_IMAGE_TAG=local
NEOWIKI_HTTP_PORT=8080
DB_USER=explorer
DB_NAME=language_gaps
# Use 1 behind HTTPS. Set 0 only for an HTTP localhost/SSH-tunnel test.
NEOWIKI_COOKIE_SECURE=1
# Set 1 only behind exactly one trusted reverse proxy; port stays bound to loopback.
NEOWIKI_TRUST_PROXY=0
# Optional explicit provider cap. Blank preserves the existing uncapped policy.
NEOWIKI_API_TOTAL_LIMIT_USD=
