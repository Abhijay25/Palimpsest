#!/usr/bin/env bash
# Cap memory of the palimpsest wiki containers as soon as they exist.
while true; do
  docker ps --filter label=com.docker.compose.project=palimpsest --format '{{.ID}} {{.Names}}' 2>/dev/null | while read -r id name; do
    case "$name" in
      *db*) m=700m ;; *jobs*) m=300m ;; *installer*) m=700m ;; *) m=450m ;;
    esac
    cur=$(docker inspect -f '{{.HostConfig.Memory}}' "$id")
    [ "$cur" = "0" ] && docker update --memory "$m" --memory-swap "$m" "$id" >/dev/null && echo "capped $name $m"
  done
  sleep 2
done
