#!/usr/bin/env bash
# Kill the newest pal-* job when the system is about to run out of memory.
while true; do
  avail=$(awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo)
  swapused=$(awk '/SwapTotal/{t=$2}/SwapFree/{f=$2}END{print int((t-f)/1024)}' /proc/meminfo)
  if [ "$avail" -lt 700 ] || { [ "$swapused" -gt 4500 ] && [ "$avail" -lt 1500 ]; }; then
    victim=$(systemctl --user list-units --type=scope --state=running --no-legend 'pal-*' | awk '{print $1}' | tail -1)
    if [ -n "$victim" ]; then systemctl --user kill -s KILL "$victim"; echo "WATCHDOG killed $victim avail=${avail}M swap=${swapused}M"
    else echo "WATCHDOG low memory avail=${avail}M swap=${swapused}M, no pal job to kill"; fi
    sleep 10
  fi
  sleep 3
done
