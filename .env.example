# Copy to .env and fill locally. Never commit .env or real credentials.
OPENAI_API_KEY=
GEMINI_API_KEY=
PALIMPSEST_USE_GEMINI=1
# Optional overrides; omit to use the detector's existing defaults.
# GEMINI_JUDGE_MODEL=
# GEMINI_REVIEWER_MODEL=
# EXA_API_KEY=

# Whole-page consistency deadline (seconds; maximum 75).
PALIMPSEST_PAGE_TIMEOUT_SECONDS=45
